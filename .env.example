# --- Backend ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Database / cache
DATABASE_URL=postgresql+psycopg://market:market@postgres:5432/market
REDIS_URL=redis://redis:6379/0

# Data providers (leave blank to use mock data)
FINNHUB_API_KEY=

# LLM (leave blank for mock AI reports)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (leave blank for mock subscriptions)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_URL=http://localhost:8000
